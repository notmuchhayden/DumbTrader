<Window x:Class="DumbTrader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ad="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:al="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        xmlns:adc="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
        xmlns:views="clr-namespace:DumbTrader.Views"
        mc:Ignorable="d"
        Title="DumbTrader"
        Width="1500" Height="900" MinWidth="1080" MinHeight="720"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource AppFont}" Foreground="{StaticResource Brush.TextPrimary}"
        UseLayoutRounding="True"
        FlowDirection="LeftToRight">

    <DockPanel>
        <!-- Top menu -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource Brush.Card}" Padding="12,5">
            <MenuItem Header="파일">
                <MenuItem Header="설정" Click="OpenSettings_Click" />
                <Separator />
                <MenuItem Header="종료"
                          Command="{Binding ExitCommand}"
                          CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
            </MenuItem>

            <MenuItem Header="보기">
                <MenuItem x:Name="SidebarMenuItem" Header="탐색" IsCheckable="True" Click="ViewMenuItem_Click" />
                <MenuItem x:Name="SummaryMenuItem" Header="계좌 요약" IsCheckable="True" Click="ViewMenuItem_Click" />
                <MenuItem x:Name="LogMenuItem" Header="활동 로그" IsCheckable="True" Click="ViewMenuItem_Click" />
            </MenuItem>

            <MenuItem Header="도움말">
                <MenuItem Header="DumbTrader 정보" Click="OpenAbout_Click" />
            </MenuItem>
        </Menu>

        <ad:DockingManager>
            <al:LayoutRoot>
                <al:LayoutPanel x:Name="RootLayoutPanel" Orientation="Horizontal">

                    <!-- Sidebar Pane (Left) -->
                    <al:LayoutAnchorablePane x:Name="SidebarPane" DockWidth="200">
                        <al:LayoutAnchorable x:Name="SidebarAnchorable" Title="탐색" CanClose="True" CanHide="True">
                            <views:SidebarView DataContext="{Binding SidebarViewModel}" />
                        </al:LayoutAnchorable>
                    </al:LayoutAnchorablePane>

                    <!-- Center Panel: Top Summary + Main + Bottom Log -->
                    <al:LayoutPanel x:Name="CenterLayoutPanel" Orientation="Vertical">
                        <!-- Summary Bar (Top) -->
                        <al:LayoutAnchorablePane x:Name="SummaryPane" DockHeight="130">
                            <al:LayoutAnchorable x:Name="SummaryAnchorable" Title="계좌 요약" CanClose="True" CanHide="True">
                                <views:SummaryView />
                            </al:LayoutAnchorable>
                        </al:LayoutAnchorablePane>

                        <!-- Main View (Document) -->
                        <al:LayoutDocumentPane>
                            <al:LayoutDocument Title="모니터링" ContentId="MainView" CanClose="False">
                                <views:MainView />
                            </al:LayoutDocument>
                        </al:LayoutDocumentPane>

                        <!-- Log Pane (Bottom) -->
                        <al:LayoutAnchorablePane x:Name="LogPane" DockHeight="140">
                            <al:LayoutAnchorable x:Name="LogAnchorable" Title="활동 로그" CanClose="True" CanHide="True">
                                <views:LogView />
                            </al:LayoutAnchorable>
                        </al:LayoutAnchorablePane>
                    </al:LayoutPanel>
                </al:LayoutPanel>
            </al:LayoutRoot>
        </ad:DockingManager>
    </DockPanel>
</Window>
