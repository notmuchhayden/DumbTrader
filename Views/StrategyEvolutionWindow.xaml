<Window x:Class="DumbTrader.Views.StrategyEvolutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DumbTrader.Views"
        Title="전략 후보 관리" Width="980" Height="690" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:CandidateStatusLabelConverter x:Key="CandidateStatusLabel"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="InstrumentTitle" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,9"/>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="봉 주기" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="Interval" Width="80" DisplayMemberPath="Name" Margin="0,0,12,0"/>
            <TextBlock Text="시작일" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="StartDate" Width="128" Margin="0,0,12,0"/>
            <Button x:Name="Generate" Content="Codex 후보 생성" Click="Generate_Click" Padding="8,3" Margin="0,0,6,0"/>
            <Button x:Name="CancelRun" Content="작업 취소" Click="Cancel_Click" IsEnabled="False" Padding="8,3" Margin="0,0,6,0"/>
            <Button Content="새로 고침" Click="Refresh_Click" Padding="8,3"/>
        </WrapPanel>
        <TextBlock Grid.Row="2" x:Name="Status" TextWrapping="Wrap" Margin="0,0,0,9" AutomationProperties.LiveSetting="Polite"/>
        <TabControl Grid.Row="3">
            <TabItem Header="후보 및 평가">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="Candidates" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                              SelectionChanged="Candidate_Changed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="생성 시각 (UTC)" Binding="{Binding CreatedAtUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="135"/>
                            <DataGridTextColumn Header="상태" Binding="{Binding Status, Converter={StaticResource CandidateStatusLabel}}" Width="95"/>
                            <DataGridTextColumn Header="변경 요약" Binding="{Binding Summary}" Width="*"/>
                            <DataGridTextColumn Header="비추천 사유" Binding="{Binding FailureReason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="1" Margin="0,8">
                        <Button x:Name="StartPaper" Content="모의 운용 시작" Click="StartPaper_Click" Margin="0,0,6,3" Padding="7,3"/>
                        <Button Content="모의 운용 중단" Click="StopPaper_Click" Margin="0,0,6,3" Padding="7,3"/>
                        <Button Content="후보 거절" Click="Reject_Click" Margin="0,0,6,3" Padding="7,3"/>
                        <Button Content="신호 버전 승인" Click="Approve_Click" Margin="0,0,6,3" Padding="7,3"/>
                        <Button Content="신호 버전 활성화" Click="Activate_Click" Margin="0,0,6,3" Padding="7,3"/>
                        <Button Content="이전 버전 복구" Click="Rollback_Click" Margin="0,0,6,3" Padding="7,3"/>
                    </WrapPanel>
                    <TextBox Grid.Row="2" x:Name="Report" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Padding="7" AutomationProperties.Name="전략 평가 보고서"/>
                </Grid>
            </TabItem>
            <TabItem Header="실행 설정">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="거래 비용, 위험 한도, Codex 실행 파일 및 스케줄을 설정합니다. 저장된 설정은 이후 평가에 사용됩니다."
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Content="설정 저장" Click="SaveSettings_Click" Margin="0,0,8,0" Padding="8,3"/>
                        <Button Content="현재 종목을 예약 대상으로 지정" Click="SetSchedule_Click" Padding="8,3"/>
                    </WrapPanel>
                    <TextBox x:Name="SettingsEditor" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             AutomationProperties.Name="전략 개선 JSON 설정"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
