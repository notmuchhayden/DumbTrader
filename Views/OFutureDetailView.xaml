<UserControl x:Class="DumbTrader.Views.OFutureDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="1200">
    <Grid Background="{StaticResource Brush.Background}" Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{StaticResource Brush.Border}" BorderThickness="2" Background="{StaticResource Brush.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="해외선물 관심계약" Style="{StaticResource TitleLarge}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding OFutureWatchlist}"
                          SelectedItem="{Binding SelectedOFutureContract, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True"
                          HeadersVisibility="Column" Foreground="{StaticResource Brush.TextPrimary}"
                          Background="{StaticResource Brush.CardAlt}" BorderBrush="{StaticResource Brush.Border}"
                          BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="계약명" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="계약코드" Binding="{Binding Symbol}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Gray" ShowsPreview="True" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="해외선물 계약 정보" Background="{StaticResource Brush.CardAlt}" Margin="0,0,0,8">
                <WrapPanel Margin="6">
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="계약명" FontWeight="Bold" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SelectedOFutureContract.Name}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="계약코드" FontWeight="Bold" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SelectedOFutureContract.Symbol}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="기초상품" FontWeight="Bold" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SelectedOFutureContract.BaseProductName}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="거래소" FontWeight="Bold" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SelectedOFutureContract.ExchangeName}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="통화" FontWeight="Bold" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SelectedOFutureContract.CurrencyCode}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="만기" FontWeight="Bold" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SelectedOFutureContract.MaturityYear}" />
                        <TextBlock Text="{Binding SelectedOFutureContract.MaturityMonth}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="틱 크기" FontWeight="Bold" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SelectedOFutureContract.TickSize}" />
                    </StackPanel>
                </WrapPanel>
            </GroupBox>

            <TabControl Grid.Row="1" Background="{StaticResource Brush.CardAlt}">
              <TabItem Header="과거 데이터">
               <GroupBox Header="해외선물 과거 데이터" Background="{StaticResource Brush.CardAlt}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="차트조회" Command="{Binding QueryOFutureChartDataCommand}"
                            HorizontalAlignment="Left" Margin="4" />
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="2*" />
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" ItemsSource="{Binding ChartData}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserResizeColumns="True" HeadersVisibility="Column"
                                  Foreground="{StaticResource Brush.TextPrimary}" Background="{StaticResource Brush.CardAlt}"
                                  BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="계약코드" Binding="{Binding Symbol}" Width="Auto" />
                                <DataGridTextColumn Header="날짜" Binding="{Binding Date}" Width="Auto" />
                                <DataGridTextColumn Header="시가" Binding="{Binding Open}" Width="Auto" />
                                <DataGridTextColumn Header="고가" Binding="{Binding High}" Width="Auto" />
                                <DataGridTextColumn Header="저가" Binding="{Binding Low}" Width="Auto" />
                                <DataGridTextColumn Header="종가" Binding="{Binding Close}" Width="Auto" />
                                <DataGridTextColumn Header="거래량" Binding="{Binding Volume}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      Background="Gray" ShowsPreview="True" />
                        <ContentControl Grid.Row="2" Content="{Binding PlotControl, Mode=OneTime}" Margin="0,4,0,0" />
                    </Grid>
                </Grid>
               </GroupBox>
              </TabItem>
              <TabItem Header="전략 / 시뮬레이션">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="12">
                    <TextBlock Text="해외선물 전략" Style="{StaticResource TitleLarge}" Margin="0,0,0,8" />
                    <TextBlock Text="계약별 주전략을 선택하면 실시간 데이터에서 신호를 계산합니다. 실시간 신호는 표시만 하며 주문을 전송하지 않습니다."
                               TextWrapping="Wrap" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                      <TextBlock Text="주전략" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <ComboBox Width="240" ItemsSource="{Binding StrategyViewModel.MainStrategyFiles}"
                                SelectedItem="{Binding StrategyViewModel.SelectedMainStrategyFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock Text="저장된 해외선물 봉으로 모의 실행" FontWeight="Bold" Margin="0,0,0,6" />
                    <WrapPanel Margin="0,0,0,8">
                      <StackPanel Margin="0,0,12,6"><TextBlock Text="봉 주기"/><ComboBox Width="100" ItemsSource="{Binding StrategyViewModel.SimulationPeriods}" DisplayMemberPath="Name" SelectedItem="{Binding StrategyViewModel.SelectedSimulationPeriod}" /></StackPanel>
                      <StackPanel Margin="0,0,12,6"><TextBlock Text="시작일"/><DatePicker SelectedDate="{Binding StrategyViewModel.SimulationStartDate}" /></StackPanel>
                      <StackPanel Margin="0,0,12,6"><TextBlock Text="초기 자본금"/><TextBox Width="120" Text="{Binding StrategyViewModel.SimulationSeedMoney, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                      <StackPanel Margin="0,0,12,6"><TextBlock Text="최대 계약 수"/><TextBox Width="90" Text="{Binding StrategyViewModel.MaxContracts, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                      <Button Content="시뮬레이션 실행" Command="{Binding StrategyViewModel.StartSimulationCommand}" Margin="0,0,8,0" />
                      <Button Content="결과 초기화" Command="{Binding StrategyViewModel.ResetSimulationCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StrategyViewModel.SimulationStatus}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding StrategyViewModel.ResultSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Text="체결은 이전 봉 종가 신호 다음 봉 시가 기준입니다. 틱 가치·증거금은 계약 정보에서 사용하며 수수료, 슬리피지, 환전 비용은 미반영입니다."
                               TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource Brush.TextSecondary}" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
