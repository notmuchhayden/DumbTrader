<Window x:Class="DumbTrader.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DumbTrader.Views"
        xmlns:vm="clr-namespace:DumbTrader.ViewModels"
        mc:Ignorable="d"
        Title="DumbTrader 로그인" Height="390" Width="370"
        Background="{StaticResource Brush.Background}" FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Border Style="{StaticResource PanelSurface}" Margin="22" Padding="22">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="DumbTrader 로그인" Style="{StaticResource TitleLarge}" Margin="0,0,0,18"/>

        <Label Grid.Row="1" Content="사용자 ID" Target="{Binding ElementName=UserNameBox}" Padding="0,4"/>
        <TextBox x:Name="UserNameBox" Grid.Row="2" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Height="30" Padding="6,3"/>

        <Label Grid.Row="3" Content="비밀번호" Target="{Binding ElementName=UserPasswordBox}" Padding="0,4"/>
        <PasswordBox Grid.Row="4" x:Name="UserPasswordBox" Margin="0,0,0,10" Height="30" Padding="6,3" VerticalAlignment="Top"
                     PasswordChanged="PasswordBox_PasswordChanged"/>

        <CheckBox Grid.Row="5" Content="비밀번호 저장" IsChecked="{Binding SavePassword, Mode=TwoWay}" Margin="0,0,0,10"/>

        <Button Grid.Row="6" Content="로그인" Style="{StaticResource PrimaryButton}" Height="34" VerticalAlignment="Top"
                HorizontalAlignment="Stretch" IsDefault="True"
                Command="{Binding LoginCommand}" 
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Grid>
    </Border>
</Window>
