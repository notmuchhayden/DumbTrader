<UserControl x:Class="DumbTrader.Views.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SummaryText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.Background}" Padding="6,3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelSurface}" Margin="0,0,4,0" Padding="8,2">
                <StackPanel>
                    <DockPanel Margin="0,0,0,2">
                        <ToggleButton x:Name="StockReturnToggle" DockPanel.Dock="Right" Content="잔고·수익률 조회" Padding="6,1" />
                        <TextBlock DockPanel.Dock="Left" Text="국내주식" Style="{StaticResource ValueText}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Style="{StaticResource SummaryText}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} {1} {2}">
                                    <Binding Path="AccountNumber" />
                                    <Binding Path="AccountName" />
                                    <Binding Path="AccountDetailName" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DockPanel>
                    <UniformGrid Columns="2">
                        <TextBlock Style="{StaticResource SummaryText}"><Run Text="예수금 " /><Run Text="{Binding Dps, Mode=OneWay, TargetNullValue=—, StringFormat=N0}" /></TextBlock>
                        <TextBlock Style="{StaticResource SummaryText}"><Run Text="잔고 손익률 " /><Run Text="{Binding PnlRat, Mode=OneWay, TargetNullValue=—, StringFormat={}{0:N2}%}" /></TextBlock>
                        <TextBlock Style="{StaticResource SummaryText}"><Run Text="투자원금 " /><Run Text="{Binding InvstOrgAmt, Mode=OneWay, TargetNullValue=—, StringFormat=N0}" /></TextBlock>
                        <TextBlock Style="{StaticResource SummaryText}"><Run Text="투자손익 " /><Run Text="{Binding InvstPlAmt, Mode=OneWay, TargetNullValue=—, StringFormat=N0}" /></TextBlock>
                        <TextBlock Style="{StaticResource SummaryText}"><Run Text="잔고 평가액 " /><Run Text="{Binding BalanceValue, Mode=OneWay, TargetNullValue=—, StringFormat=N0}" /></TextBlock>
                        <TextBlock Text="{Binding StockBalanceStatus}" Style="{StaticResource SummaryText}" Foreground="{StaticResource Brush.TextSecondary}" />
                    </UniformGrid>
                    <TextBlock Text="{Binding StockReturnText}" Style="{StaticResource SummaryText}" />

                    <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=StockReturnToggle}"
                           IsOpen="{Binding IsChecked, ElementName=StockReturnToggle}"
                           AllowsTransparency="True" PreviewKeyDown="StockReturnPopup_PreviewKeyDown">
                        <Border Style="{StaticResource PanelSurface}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,8,0">
                                    <Label Content="시작일" Target="{Binding ElementName=StockReturnStart}" Padding="0" />
                                    <DatePicker x:Name="StockReturnStart" SelectedDate="{Binding ReturnStart, Mode=OneTime}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <Label Content="종료일" Target="{Binding ElementName=StockReturnEnd}" Padding="0" />
                                    <DatePicker x:Name="StockReturnEnd" SelectedDate="{Binding ReturnEnd, Mode=OneTime}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <Label Content="계좌 비밀번호" Target="{Binding ElementName=StockReturnPassword}" Padding="0" />
                                    <PasswordBox x:Name="StockReturnPassword" Width="100" MaxLength="8" />
                                </StackPanel>
                                <Button Content="적용" Style="{StaticResource PrimaryButton}" Click="ConfigureStockReturn_Click"
                                        VerticalAlignment="Bottom" Padding="10,2" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelSurface}" Margin="4,0,0,0" Padding="8,4">
                <StackPanel>
                    <DockPanel Margin="0,0,0,2">
                        <ToggleButton x:Name="FutureBalanceToggle" DockPanel.Dock="Right" Content="잔고 조회" Padding="6,1" />
                        <ComboBox x:Name="FutureCurrency" DockPanel.Dock="Right" Margin="0,0,6,0"
                                  ItemsSource="{Binding FutureRows}" DisplayMemberPath="CurrencyCode"
                                  SelectedItem="{Binding SelectedFutureBalance, Mode=TwoWay}"
                                  AutomationProperties.Name="해외선물 잔고 통화">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Style.Triggers>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <TextBlock Text="해외선물" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding FutureStatus}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryText}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ContentControl Content="{Binding SelectedFutureBalance}" HorizontalContentAlignment="Stretch">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <Trigger Property="Content" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <UniformGrid Columns="2">
                                    <TextBlock Style="{StaticResource SummaryText}"><Run Text="예수금 " /><Run Text="{Binding Deposit, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Style="{StaticResource SummaryText}"><Run Text="평가자산 " /><Run Text="{Binding EvaluationAsset, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Style="{StaticResource SummaryText}"><Run Text="평가손익 " /><Run Text="{Binding EvaluationPnl, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Style="{StaticResource SummaryText}"><Run Text="청산손익 " /><Run Text="{Binding LiquidationPnl, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Style="{StaticResource SummaryText}"><Run Text="주문가능 " /><Run Text="{Binding OrderableAmount, Mode=OneWay}" /></TextBlock>
                                </UniformGrid>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=FutureBalanceToggle}"
                           IsOpen="{Binding IsChecked, ElementName=FutureBalanceToggle, Mode=TwoWay}"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Style="{StaticResource PanelSurface}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,8,0">
                                    <Label Content="계좌 구분" Target="{Binding ElementName=FutureAccountType}" Padding="0" />
                                    <TextBox x:Name="FutureAccountType" Width="64" MaxLength="1" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <Label Content="해외선물 계좌번호" Target="{Binding ElementName=FutureAccount}" Padding="0" />
                                    <TextBox x:Name="FutureAccount" Width="140" MaxLength="20" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <Label Content="계좌 비밀번호" Target="{Binding ElementName=FuturePassword}" Padding="0" />
                                    <PasswordBox x:Name="FuturePassword" Width="100" MaxLength="8" />
                                </StackPanel>
                                <Button Content="조회" Style="{StaticResource PrimaryButton}" Click="QueryFutureBalance_Click"
                                        VerticalAlignment="Bottom" Padding="10,2" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
